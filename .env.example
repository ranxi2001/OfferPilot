# ===========================
# OfferPilot 模型配置
# 配置 API Key 后对应模型自动可用
# 侧边栏可快速切换，或通过弹窗编辑
# ===========================

# --- 服务端保护 ---

# Docker/生产环境中，Next.js 服务端会用这个 token 调后端 API。
# 直接访问后端时需要 Authorization: Bearer <OFFERPILOT_API_KEY>。
OFFERPILOT_API_KEY=change-me-in-production
OFFERPILOT_REQUIRE_AUTH=false
OFFERPILOT_ALLOWED_ORIGINS=http://localhost:3000
# 仅旧 TypeScript 后端使用，Go 主后端直接动态解析 Markdown 题块。
OFFERPILOT_SEED_KNOWLEDGE_ON_START=true
OFFERPILOT_HEALTH_TIMEOUT_MS=3000
OFFERPILOT_ENABLE_CONFIG_API=false
KNOWLEDGE_DIR=knowledge
DB_PATH=data/offerpilot.db
OFFERPILOT_MAX_INTERVIEW_BODY_BYTES=2097152
OFFERPILOT_HARNESS_MAX_CONCURRENT=4
# Typed Agent wall-clock limits. Go duration strings are recommended.
OFFERPILOT_INTERVIEWER_TIMEOUT=90s
OFFERPILOT_ASSESSOR_TIMEOUT=120s
OFFERPILOT_REPORTER_TIMEOUT=90s
OFFERPILOT_PLANNER_TIMEOUT=90s
# 本地 Clash/TUN fake-IP (198.18.0.0/15) 自动在非 production 开启；生产保持 false。
OFFERPILOT_ALLOW_TUN_FAKE_IP=

# --- 文本模型 ---

# Anthropic Claude（当前由旧 CLI / serve:legacy 使用）
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / 兼容接口
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT=90s

# DeepSeek（当前由旧 CLI / serve:legacy 使用）
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- TTS 语音合成 ---

MIMO_API_KEY=sk-...
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=alloy

# OpenAI TTS (复用 OPENAI_API_KEY)
OPENAI_TTS_MODEL=tts-1

# --- 语音识别 / 多模态 ---

MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_ASR_LANGUAGE=auto

# OpenAI Whisper (复用 OPENAI_API_KEY)
OPENAI_ASR_MODEL=whisper-1
