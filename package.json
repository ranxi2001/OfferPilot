{
  "name": "offer-pilot",
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "OfferPilot —— 基于 Harness 工程架构的 AI 面试诊断 Agent",
  "scripts": {
    "start": "tsx src/index.ts start",
    "diagnose": "tsx src/index.ts diagnose",
    "build-kb": "tsx src/index.ts build-kb",
    "embed": "tsx src/index.ts embed",
    "serve": "cd backend && go run ./cmd/offerpilot-api",
    "serve:legacy": "tsx src/server.ts",
    "build": "npm run build:legacy && npm run build:go",
    "build:legacy": "tsc",
    "build:go": "cd backend && go build ./...",
    "test:go": "cd backend && go test ./...",
    "test": "vitest",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "openai": "^4.70.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
